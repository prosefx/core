<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.prosefx</groupId>
    <artifactId>prosefx-core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>prosefx core</name>
    <description>ProseMirror document model, schema, commands and input rules on the JVM, built on Atlassian prosemirror-kotlin. No JavaFX.</description>
    <url>https://github.com/prosefx/core</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>prosefx</id>
            <name>Ivan Velikanov</name>
            <email>ivan.velikanov.dev@gmail.com</email>
            <url>https://github.com/prosefx</url>
        </developer>
    </developers>
    <scm>
        <url>https://github.com/prosefx/core</url>
        <connection>scm:git:https://github.com/prosefx/core.git</connection>
        <developerConnection>scm:git:git@github.com:prosefx/core.git</developerConnection>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <prosefx.version>0.1.0-SNAPSHOT</prosefx.version>
        <prosemirror.version>1.1.21</prosemirror.version>
        <javafx.version>26.0.2</javafx.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.atlassian.prosemirror</groupId>
            <artifactId>model-jvm</artifactId>
            <version>${prosemirror.version}</version>
        </dependency>
        <dependency>
            <groupId>com.atlassian.prosemirror</groupId>
            <artifactId>state-jvm</artifactId>
            <version>${prosemirror.version}</version>
        </dependency>
        <dependency>
            <groupId>com.atlassian.prosemirror</groupId>
            <artifactId>transform-jvm</artifactId>
            <version>${prosemirror.version}</version>
        </dependency>
        <dependency>
            <groupId>com.atlassian.prosemirror</groupId>
            <artifactId>history-jvm</artifactId>
            <version>${prosemirror.version}</version>
        </dependency>
        <dependency>
            <groupId>com.atlassian.prosemirror</groupId>
            <artifactId>util-jvm</artifactId>
            <version>${prosemirror.version}</version>
        </dependency>
        <dependency>
            <groupId>com.atlassian.prosemirror</groupId>
            <artifactId>test-builder-jvm</artifactId>
            <version>${prosemirror.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>
